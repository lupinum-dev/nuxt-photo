{
  "name": "@lupinum/vue-photo",
  "version": "1.0.0-beta.1",
  "description": "Vue components, composables, and photo utilities for Nuxt Photo.",
  "keywords": [
    "gallery",
    "lightbox",
    "nuxt-photo",
    "photos",
    "vue"
  ],
  "homepage": "https://nuxt-photo.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-photo/issues"
  },
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-photo.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.mjs"
    },
    "./provide": {
      "types": "./dist/provide/index.d.ts",
      "import": "./dist/provide/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.public-api.json && vue-tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-vue": "8.6.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "^3.6.1",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}

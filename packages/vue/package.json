{
  "name": "@nuxt-photo/vue",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue components, composables, and photo utilities for Nuxt Photo.",
  "keywords": [
    "nuxt-photo",
    "vue",
    "photos",
    "gallery",
    "lightbox"
  ],
  "homepage": "https://github.com/lupinum-dev/nuxt-photo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-photo.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-photo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./composables": {
      "import": "./dist/composables/index.mjs",
      "types": "./dist/composables/index.d.ts"
    },
    "./provide": {
      "import": "./dist/provide/keys.mjs",
      "types": "./dist/provide/keys.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.mjs",
      "types": "./dist/types/index.d.ts"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub"
  },
  "dependencies": {
    "embla-carousel": "9.0.0-rc02",
    "embla-carousel-autoplay": "9.0.0-rc02",
    "embla-carousel-vue": "9.0.0-rc02"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "unbuild": "^3.5.0",
    "vue": "3.5.33",
    "vue-tsc": "3.2.7"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  }
}

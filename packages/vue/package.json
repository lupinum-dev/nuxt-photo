{
  "name": "@lupinum/vue-photo",
  "version": "0.2.1",
  "description": "Vue components, composables, and photo utilities for Nuxt Photo.",
  "keywords": [
    "gallery",
    "lightbox",
    "nuxt-photo",
    "photos",
    "vue"
  ],
  "homepage": "https://nuxt-photo.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-photo/issues"
  },
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-photo.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.mjs"
    },
    "./provide": {
      "types": "./dist/provide/index.d.ts",
      "import": "./dist/provide/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs"
    },
    "./components/Lightbox": {
      "types": "./dist/components/Lightbox.vue.d.ts",
      "import": "./dist/components/Lightbox.vue"
    },
    "./components/Photo": {
      "types": "./dist/components/Photo.vue.d.ts",
      "import": "./dist/components/Photo.vue"
    },
    "./components/PhotoAlbum": {
      "types": "./dist/components/PhotoAlbum.vue.d.ts",
      "import": "./dist/components/PhotoAlbum.vue"
    },
    "./components/PhotoCarousel": {
      "types": "./dist/components/PhotoCarousel.vue.d.ts",
      "import": "./dist/components/PhotoCarousel.vue"
    },
    "./components/PhotoGroup": {
      "types": "./dist/components/PhotoGroup.vue.d.ts",
      "import": "./dist/components/PhotoGroup.vue"
    },
    "./primitives/LightboxProvider": {
      "types": "./dist/primitives/LightboxProvider.vue.d.ts",
      "import": "./dist/primitives/LightboxProvider.vue"
    },
    "./primitives/LightboxRoot": {
      "types": "./dist/primitives/LightboxRoot.vue.d.ts",
      "import": "./dist/primitives/LightboxRoot.vue"
    },
    "./primitives/LightboxOverlay": {
      "types": "./dist/primitives/LightboxOverlay.vue.d.ts",
      "import": "./dist/primitives/LightboxOverlay.vue"
    },
    "./primitives/LightboxViewport": {
      "types": "./dist/primitives/LightboxViewport.vue.d.ts",
      "import": "./dist/primitives/LightboxViewport.vue"
    },
    "./primitives/LightboxSlide": {
      "types": "./dist/primitives/LightboxSlide.vue.d.ts",
      "import": "./dist/primitives/LightboxSlide.vue"
    },
    "./primitives/LightboxControls": {
      "types": "./dist/primitives/LightboxControls.vue.d.ts",
      "import": "./dist/primitives/LightboxControls.vue"
    },
    "./primitives/LightboxCaption": {
      "types": "./dist/primitives/LightboxCaption.vue.d.ts",
      "import": "./dist/primitives/LightboxCaption.vue"
    },
    "./primitives/PhotoTrigger": {
      "types": "./dist/primitives/PhotoTrigger.vue.d.ts",
      "import": "./dist/primitives/PhotoTrigger.vue"
    },
    "./primitives/PhotoImage": {
      "types": "./dist/primitives/PhotoImage.vue.d.ts",
      "import": "./dist/primitives/PhotoImage.vue"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./styles/album.css": {
      "default": "./dist/styles/album.css"
    },
    "./styles/carousel-structure.css": {
      "default": "./dist/styles/carousel-structure.css"
    },
    "./styles/carousel-theme.css": {
      "default": "./dist/styles/carousel-theme.css"
    },
    "./styles/lightbox.css": {
      "default": "./dist/styles/lightbox.css"
    },
    "./styles/lightbox-structure.css": {
      "default": "./dist/styles/lightbox-structure.css"
    },
    "./styles/lightbox-theme.css": {
      "default": "./dist/styles/lightbox-theme.css"
    },
    "./styles/photo-structure.css": {
      "default": "./dist/styles/photo-structure.css"
    },
    "./styles/photo.css": {
      "default": "./dist/styles/photo.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.public-api.json"
  },
  "dependencies": {
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-vue": "8.6.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "^3.6.1",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}

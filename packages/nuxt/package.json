{
  "name": "@lupinum/nuxt-photo",
  "version": "1.0.0-rc.0",
  "description": "Photo galleries, lightboxes, and provider-aware image rendering for Nuxt.",
  "keywords": [
    "gallery",
    "lightbox",
    "nuxt",
    "nuxt-photo",
    "photos"
  ],
  "homepage": "https://nuxt-photo.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-photo/issues"
  },
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-photo.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./app": {
      "types": "./dist/runtime/app.d.ts",
      "import": "./dist/runtime/app.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub"
  },
  "dependencies": {
    "@lupinum/vue-photo": "workspace:*",
    "@nuxt/kit": "4.4.8",
    "@nuxt/schema": "4.4.8"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/image": "^2.0.0",
    "nuxt": "^4.4.8"
  },
  "peerDependenciesMeta": {
    "@nuxt/image": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}

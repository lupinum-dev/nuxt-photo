{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": {
      "@lupinum/vue-photo": ["packages/vue/src/index.ts"],
      "@lupinum/vue-photo/*": ["packages/vue/src/*"],
      "@lupinum/nuxt-photo": ["packages/nuxt/src/module.ts"],
      "@lupinum/nuxt-photo/app": ["packages/nuxt/src/runtime/app.ts"]

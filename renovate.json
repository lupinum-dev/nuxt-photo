{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "rangeStrategy": "replace",
  "schedule": ["before 6am on Monday"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "groupName": "Nuxt ecosystem",
      "matchPackageNames": [
        "nuxt",
        "@nuxt/**",
        "vue",
        "vue-router",
        "@vue/**",
        "@vitejs/plugin-vue",
        "vue-tsc"
      ]
    },
    {
      "groupName": "Vite+ toolchain",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/**",
        "vite",
        "vitest",
        "@vitest/**",
        "rolldown",
        "typescript"
      ]
    },
    { "groupName": "GitHub Actions", "matchManagers": ["github-actions"] },
    { "groupName": "Changesets", "matchPackageNames": ["@changesets/**"] },
    {
      "groupName": "Ginko docs",
      "matchPackageNames": ["@lupinum/ginko-content", "@lupinum/ginko-docs"]
    },
    {
      "description": "The Embla packages are an exact prerelease tuple.",
      "groupName": "Embla carousel",
      "matchPackageNames": ["embla-carousel", "embla-carousel-autoplay", "embla-carousel-vue"],
      "rangeStrategy": "pin"
    }
  ]
}
